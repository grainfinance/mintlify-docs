{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Grain Developer Portal",
  "api": {
    "openapi": "https://grain-docs-assets.s3.us-east-1.amazonaws.com/openapi.yaml"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "colors": {
    "primary": "#3D82F7",
    "light": "#6AA0F9",
    "dark": "#2563EB"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Get Started",
        "pages": [
          "index",
          "get-started/index",
          "get-started/setup-your-configuration",
          "get-started/retrieve-api-keys",
          "get-started/create-your-first-customer",
          "get-started/create-your-first-hedge",
          "get-started/hedge-settlement"
        ]
      },
      {
        "tab": "Concepts",
        "pages": [
          "concepts/core-concepts",
          "concepts/quotes",
          "concepts/hedge-lifecycle",
          "concepts/settlements",
          "concepts/funding-wallets",
          "concepts/payouts"
        ]
      },
      {
        "tab": "API",
        "groups": [
          {
            "group": "Basics",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication"
            ]
          },
          {
            "group": "Hedges",
            "pages": [
              {
                "group": "Realtime",
                "pages": [
                  "api-reference/hedges/get-quote",
                  "api-reference/hedges/accept-quote"
                ],
                "expanded": true
              },
              {
                "group": "Offline",
                "pages": [
                  "api-reference/hedges/get-offline-rates",
                  "api-reference/hedges/accept-offline-quote"
                ],
                "expanded": true
              },
              {
                "group": "Early Settlement",
                "expanded": true,
                "pages": [
                  "api-reference/hedges/early-settlement-quote",
                  "api-reference/hedges/early-settlement-accept"
                ]
              },
              "api-reference/hedges/list-hedges",
              "api-reference/hedges/get-hedge",
              "api-reference/hedges/cancel-hedge"
            ]
          },
          {
            "group": "Dual Hedges",
            "pages": [
              "api-reference/dual-hedges/get-offline-rates",
              "api-reference/dual-hedges/accept-offline-quote",
              "api-reference/dual-hedges/list-dual-hedges",
              "api-reference/dual-hedges/get-dual-hedge",
              "api-reference/dual-hedges/cancel-dual-hedge"
            ]
          },
          {
            "group": "Customers",
            "pages": [
              "api-reference/customers/create-customer",
              "api-reference/customers/list-customers",
              "api-reference/customers/get-customer",
              "api-reference/customers/update-customer",
              "api-reference/customers/delete-customer"
            ]
          },
          {
            "group": "Spots",
            "pages": [
              "api-reference/spots/get-quote",
              "api-reference/spots/accept-quote",
              "api-reference/spots/list-spots",
              "api-reference/spots/get-spot"
            ]
          },
          {
            "group": "Payouts",
            "pages": [
              "api-reference/payouts/review-payout",
              "api-reference/payouts/submit-payout"
            ]
          },
          {
            "group": "Wallets",
            "pages": [
              "api-reference/wallets/list-wallets",
              "api-reference/wallets/get-wallet",
              "api-reference/wallets/withdraw"
            ]
          },
          {
            "group": "Pricing",
            "pages": [
              "api-reference/pricing/get-exchange-rate"
            ]
          }
        ]
      },
      {
        "tab": "Webhooks",
        "pages": [
          "webhooks/index",
          "webhooks/signature-verification",
          "webhooks/webhook-envelope",
          {
            "group": "Events",
            "pages": [
              "webhooks/events/hedge-cancelled",
              "webhooks/events/hedge-completed",
              "webhooks/events/hedge-overdue",
              "webhooks/events/hedge-initial-collateral-received",
              "webhooks/events/hedge-initial-collateral-overdue",
              "webhooks/events/hedge-upcoming-settlement",
              "webhooks/events/wallet-deposit-received"
            ]
          },
          "webhooks/best-practices"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@grainfinance.co"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://console.grainfinance.co"
    }
  },
  "footer": {
    "copyright": "Copyright © 2026 Grain Finance, Inc."
  }
}
